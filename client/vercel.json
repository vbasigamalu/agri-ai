{
  "rewrites": [
    {
      "source": "/analyze",
      "destination": "https://agri-ai-backend.onrender.com/analyze"
    },
    {
      "source": "/chat",
      "destination": "https://agri-ai-backend.onrender.com/chat"
    },
    {
      "source": "/history",
      "destination": "/api/history"
    },
    {
      "source": "/status",
      "destination": "/api/status"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://agri-ai-backend.onrender.com/uploads/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
